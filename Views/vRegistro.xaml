<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mpalloExamen.Views.vRegistro"
             Title="Registro"
             BackgroundColor="WhiteSmoke">

    <!-- ESTILOS -->
    <ContentPage.Resources>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="DarkBlue" />
        </Style>
        
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="DarkBlue" />
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Blue" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>

        <Style x:Key="EstiloTituloRegistro" TargetType="Label">
            <Setter Property="TextColor" Value="Blue" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,20" />
        </Style>
        
    </ContentPage.Resources>

    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="lblUsuarioConectado" Text="Usuario conectado: " TextColor="Purple" FontSize="14" />

            <Label Text="REGISTRO" Style="{StaticResource EstiloTituloRegistro}" />

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *" RowSpacing="10" ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre" />
                <Label Grid.Row="0" Grid.Column="1" Text="Apellido" />
                <Label Grid.Row="0" Grid.Column="2" Text="Edad" />

                <Entry Grid.Row="1" Grid.Column="0" x:Name="txtNombre" Placeholder="Ingresar Nombre" />
                <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellido" Placeholder="Ingresar Apellido" />
                <Entry Grid.Row="1" Grid.Column="2" x:Name="txtEdad" Placeholder="Edad" Keyboard="Numeric" />
            </Grid>

            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="150, *" RowSpacing="10" ColumnSpacing="10" Margin="0,20,0,0">

                <Label Grid.Row="0" Grid.Column="0" Text="Fecha de inicio:" />
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dtpFechaInicio" />

                <Label Grid.Row="1" Grid.Column="0" Text="Plan:" />
                <Picker Grid.Row="1" Grid.Column="1" x:Name="pckPlan" Title="Seleccione Plan">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Grid.Row="2" Grid.Column="0" Text="Casillero:" />
                <Switch Grid.Row="2" Grid.Column="1" x:Name="swtCasillero" HorizontalOptions="Start" />

                <Label Grid.Row="3" Grid.Column="0" Text="Monto Inicial:" />
                <Entry Grid.Row="3" Grid.Column="1" x:Name="txtMontoInicial" Placeholder="Entre 120 y 600" Keyboard="Numeric" />

                <Button Grid.Row="4" Grid.Column="0" Text="Calcular Pago" Clicked="OnCalcularClicked" />
                <Entry Grid.Row="4" Grid.Column="1" x:Name="txtPagoMensual" Placeholder="Pago mensual" IsReadOnly="True" BackgroundColor="#E0E0E0" />
            </Grid>

            <Button Text="Ver Resumen" Clicked="OnVerResumenClicked" Margin="0,30,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>