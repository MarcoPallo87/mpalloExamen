<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mpalloExamen.Views.vResumen"
             Title="Resumen"
             BackgroundColor="WhiteSmoke">

    <!-- ESTILOS -->
    <ContentPage.Resources>
        
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,10" />
        </Style>

        <Style x:Key="EstiloTituloResumen" TargetType="Label">
            <Setter Property="TextColor" Value="Purple" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,10,0,20" />
        </Style>

        <Style x:Key="EstiloLabelDato" TargetType="Label">
            <Setter Property="TextColor" Value="Blue" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        
    </ContentPage.Resources>

    <ScrollView Orientation="Vertical">
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="lblUsuarioConectado" TextColor="Purple" FontAttributes="Bold" FontSize="14" />

            <Label Text="RESUMEN" Style="{StaticResource EstiloTituloResumen}" />

            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" 
                  ColumnDefinitions="150, *" 
                  RowSpacing="10" 
                  ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre" />

                <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido" />

                <Label Grid.Row="2" Grid.Column="0" Text="Edad:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad" />

                <Label Grid.Row="3" Grid.Column="0" Text="Fecha de inicio:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="3" Grid.Column="1" x:Name="lblFechaInicio" />

                <Label Grid.Row="4" Grid.Column="0" Text="Plan:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="4" Grid.Column="1" x:Name="lblPlan" />

                <Label Grid.Row="5" Grid.Column="0" Text="Casillero:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="5" Grid.Column="1" x:Name="lblCasillero" />

                <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="6" Grid.Column="1" x:Name="lblMontoInicial" />

                <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="7" Grid.Column="1" x:Name="lblPagoMensual" />

                <Label Grid.Row="8" Grid.Column="0" Text="Pago Total:" Style="{StaticResource EstiloLabelDato}" />
                <Label Grid.Row="8" Grid.Column="1" x:Name="lblPagoTotal" FontAttributes="Bold" TextColor="Red" />
            </Grid>

            <Button Text="Exportar a TXT" Clicked="OnExportarClicked" BackgroundColor="Green" TextColor="White" Margin="0,20,0,0"/>

            <Button Text="Nuevo registro" Clicked="OnNuevoRegistroClicked" BackgroundColor="Blue" TextColor="White" />

            <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" BackgroundColor="Gray" TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>